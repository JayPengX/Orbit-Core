 On the owner's Mac: Node 22 in `~/.local/opt/node`, Playwright (WebKit and
 Chromium) in `~/.local/opt/playwright`; `preview.mjs` finds them itself.
 
+**Chinese in screenshots on Linux.** The cloud's Chromium has no PingFang, and
+the page's font stack ('PingFang TC', 'Noto Sans TC') named nothing installed
+there, so Chinese fell to `sans-serif`: boxes, or the Japanese forms of a
+generic Noto CJK (2026-11-14). Install `fonts-noto-cjk` (the screenshot
+workflows do); every tool here calls `tools/fonts.mjs`, which prefers
+Noto Sans CJK TC for Traditional Chinese and warns when it isn't installed.
+Pages carry `lang="zh-Hant"`, browsers `zh-TW`.
+
 ## `node tools/shots.mjs <app> [page…]`: every screenshot a change needs
 
 The one way to take screenshots. Each page on every screen (320 and 390
diff --git a/tools/fonts.mjs b/tools/fonts.mjs
new file mode 100644
index 0000000..eebaa01
--- /dev/null
+++ b/tools/fonts.mjs
@@ -0,0 +1,62 @@
+// Chinese in a screenshot, as an iPhone shows it (PingFang TC): Traditional
+// Chinese glyphs, never Japanese ones.
+//
+// Why it went wrong: on Linux the page's font stack names 'PingFang TC' and
+// 'Noto Sans TC', and neither is installed there (the Debian/Ubuntu package
+// fonts-noto-cjk holds "Noto Sans CJK TC"). The stack fell through to
+// `sans-serif`, which fontconfig answers with the first CJK font it has:
+// Noto Sans CJK JP (Japanese forms of 直, 骨, 角, 令…), or none at all (empty
+// boxes) when no CJK font was installed.
+//
+// What fixes it: (1) the font installed (`sudo apt-get install -y
+// fonts-noto-cjk`; the workflows that take screenshots do it), (2) this file,
+// called by every screenshot tool before it opens a browser: a fontconfig
+// preference that makes Traditional Chinese (and any unmarked Han text) draw
+// in Noto Sans CJK TC, and the names the page asks for ('PingFang TC',
+// 'Noto Sans TC') answer with it, and (3) the pages carry lang="zh-Hant" and
+// the browser's locale is zh-TW.
+// A warning, never a stop, when the font is missing.
+import { execFileSync } from 'node:child_process';
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
+import { homedir } from 'node:os';
+import { join } from 'node:path';
+
+const TC = 'Noto Sans CJK TC';
+const CONF = `<?xml version="1.0"?>
+<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
+<fontconfig>
+  <!-- Orbit screenshots: Traditional Chinese as an iPhone shows it (tools/fonts.mjs) -->
+  <alias binding="same"><family>PingFang TC</family><prefer><family>${TC}</family></prefer></alias>
+  <alias binding="same"><family>Noto Sans TC</family><prefer><family>${TC}</family></prefer></alias>
+  <match target="pattern">
+    <test name="lang" compare="contains"><string>zh-tw</string></test>
+    <edit name="family" mode="prepend" binding="strong"><string>${TC}</string></edit>
+  </match>
+  <match target="pattern">
+    <test name="family"><string>sans-serif</string></test>
+    <edit name="family" mode="append" binding="same"><string>${TC}</string></edit>
+  </match>
+  <match target="pattern">
+    <test name="family"><string>system-ui</string></test>
+    <edit name="family" mode="append" binding="same"><string>${TC}</string></edit>
+  </match>
+</fontconfig>
+`;
+
+export function chineseFonts() {
+  if (process.platform !== 'linux') return true;
+  try {
+    const dir = join(process.env.XDG_CONFIG_HOME || join(homedir(), '.config'), 'fontconfig/conf.d');
+    const file = join(dir, '60-orbit-zh-hant.conf');
+    if (!existsSync(file) || readFileSync(file, 'utf8') !== CONF) (mkdirSync(dir, { recursive: true }), writeFileSync(file, CONF));
+    const have = execFileSync('fc-list', [`:lang=zh-tw`, 'family'], { encoding: 'utf8' });
+    if (!/CJK TC|Noto Sans TC/.test(have)) {
+      console.warn('warning: no Traditional Chinese font (Noto Sans CJK TC): Chinese will draw as boxes or Japanese forms. Install it: sudo apt-get install -y fonts-noto-cjk');
+      return false;
+    }
+  } catch (e) {
+    console.warn(`warning: could not check the Chinese font (${e.code || e.message})`);
+    return false;
+  }
+  return true;
+}
