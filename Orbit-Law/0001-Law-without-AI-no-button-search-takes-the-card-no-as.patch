diff --git a/public/look.css b/public/look.css
index 8d9e03d..4d598eb 100644
--- a/public/look.css
+++ b/public/look.css
@@ -290,3 +290,12 @@ html[data-look='native'].q-wide .nv-asks {
 html[data-look='native'][data-look='native'] #panel-home .q-section-head > :is(a, button) {
   color: var(--q-label-2);
 }
